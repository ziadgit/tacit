# tacit bridge on a Raspberry Pi hub (SPEC §13.8). Install:
#   sudo cp deploy/pi/tacit-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tacit-bridge
[Unit]
Description=tacit band bridge (one of the team's own bands)
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=tacit
Group=tacit
WorkingDirectory=/opt/tacit
EnvironmentFile=/opt/tacit/.env
ExecStart=/opt/tacit/.venv/bin/tacit bridge
Restart=always
RestartSec=5
# The muted state lives in /opt/tacit/data/bridge-state.json, so a restart comes back muted.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
