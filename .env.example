# Copy to .env (gitignored) and fill in the values yourself. Never paste keys into a chat.
#   cp .env.example .env

# Which of the team's bands this laptop drives: 16 (Vexo-HACK-16) or 74 (Vexo-HACK-74).
TACIT_BAND=

# Speech to text (Nova-3) and voice (Aura): https://console.deepgram.com
DEEPGRAM_API_KEY=
# The Vexo kit's AI examples (examples/python/ai.py) use this: organisers hand it out
OPENAI_API_KEY=
# Live web search / research: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Jev decision model through TypeSafe: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Optional: phone / voice agent: https://dashboard.vapi.ai
VAPI_API_KEY=


# --- the tacit server (onboarding, interview, payments) ---
# Signs the session cookie: openssl rand -hex 32
SESSION_SECRET=
# Vapi sends this header to /vapi/webhook: openssl rand -hex 32
VAPI_SERVER_SECRET=
# Where the server lives, https, no trailing slash (e.g. https://tacit-vexohacks.fly.dev)
PUBLIC_BASE_URL=
# Vapi assistant made by `tacit vapi-sync`, and the Vapi phone number used for outbound calls
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# The inbound number shown in the app, e.g. (415) 555-0100
TACIT_PHONE_DISPLAY=
# Outbound calls only go to these E.164 numbers, comma-separated. Empty = no outbound calls
CALL_ALLOWLIST=
# Stripe, TEST MODE ONLY (sk_test_...); live keys are refused
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# MiniMax image generation for profile pictures
MINIMAX_API_KEY=

# --- the band bridge (from pairing in the app, #/me -> connect a band) ---
TACIT_BRIDGE_TOKEN=
# Where the bridge uploads; defaults to PUBLIC_BASE_URL
TACIT_SERVER_URL=

# Optional, shown with defaults:
# OPENAI_MODEL=gpt-6-luna                # extraction model for band conversations
# SCENARIO_THRESHOLD=0.6                 # Jev probability that counts as a detection
# WINDOWS_PER_HOUR=40                    # cap on transcript windows checked per band per hour
# MUTE_REWIND_S=15                       # seconds dropped when you mute
# BRIDGE_BUFFER_MB=500                   # offline audio buffer cap
# VAPI_LLM_PROVIDER=openai               # the interviewer's model provider
# VAPI_LLM_MODEL=gpt-4.1                 # the interviewer's model
# VAPI_VOICE_ID=asteria                  # Deepgram Aura voice on the call
# INTERVIEW_MAX_SECONDS=600              # longest interview call
# FOLLOW_PRICE_CENTS=500                 # one-time price to unlock followers-only skills (USD)
# TACIT_DATA_DIR=data                    # where tacit.db lives
# EXA_TIMEOUT_S=8.0                      # Exa lookup timeout
# JEV_TIMEOUT_S=5.0                      # Jev check timeout
# CALLS_PER_USER_PER_DAY=3               # interview calls per person per day
# LOOKUPS_PER_USER_PER_DAY=3             # Exa lookups per person per day
# PORTRAITS_PER_USER_PER_DAY=3           # MiniMax picture requests per person per day
# MINIMAX_BASE_URL=https://api.minimax.io
# JEV_MODEL=jev-1.13.0
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
